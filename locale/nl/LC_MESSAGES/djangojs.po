msgid "Choose %s by selecting them and then select the \"Choose\" arrow button."
msgstr "Kies %s door ze te selecteren en daarna op de pijl 'Kiezen' te klikken."

msgid "Remove %s by selecting them and then select the \"Remove\" arrow button."
msgstr "Verwijder %s door ze te selecteren en daarna op de pijl 'Verwijderen' te klikken."

msgid "Choose all %s"
msgstr "Alle %s kiezen"

msgid "Choose selected %s"
msgstr "Geselecteerde %s kiezen"

msgid "Remove selected %s"
msgstr "Geselecteerde %s verwijderen"

msgid "Remove all %s"
msgstr "Alle %s verwijderen"

msgid "(click to clear)"
msgstr "(klik om te wissen)"
