# Real .env files are created once, by hand, directly on each host --
# never committed. chmod 600 this file once it has real values in it
# (see infra/README.md).

# --- Core ---
DJANGO_SECRET_KEY=                      # generate with: python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=app.loefbijter.nl   # confirm this is still the right hostname (see docs/deployment.rst pre-flight)
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.loefbijter.nl

# --- Database ---
# See the header comment in docker-compose.yml for which variant applies
# (Postgres containerized alongside the app, vs. already running on the host).
DJANGO_DATABASE_URL=postgres://loefsys:CHANGEME@db:5432/loefsys
DJANGO_DATABASE_CONN_MAX_AGE=60
# Only needed for the containerized-Postgres compose variant -- must match
# the user/password/db name encoded in DJANGO_DATABASE_URL above:
POSTGRES_DB=loefsys
POSTGRES_USER=loefsys
POSTGRES_PASSWORD=CHANGEME

# --- Email ---
# EMAIL_BACKEND defaults to a filebased backend that writes inside the
# container -- i.e. every email silently vanishes on the next redeploy unless
# this is set explicitly:
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true

# --- Misc ---
DJANGO_TIME_ZONE=Europe/Amsterdam
