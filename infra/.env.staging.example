# Real .env files are created once, by hand, directly on each host --
# never committed. chmod 600 this file once it has real values in it
# (see infra/README.md).
#
# Same shape as infra/.env.production.example -- kept as a separate file
# (rather than one shared template) so staging and production secrets are
# never mixed up when copying values onto a host.

# --- Core ---
DJANGO_SECRET_KEY=                      # generate with: python -c "import secrets;print(secrets.token_urlsafe(50))" -- use a DIFFERENT value than production
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=staging.loefbijter.nl   # confirm the actual staging hostname (see docs/deployment.rst pre-flight)
DJANGO_CSRF_TRUSTED_ORIGINS=https://staging.loefbijter.nl

# --- Database ---
# Staging should have its own database, separate from production's live data.
DJANGO_DATABASE_URL=postgres://loefsys:CHANGEME@db:5432/loefsys
DJANGO_DATABASE_CONN_MAX_AGE=60
POSTGRES_DB=loefsys
POSTGRES_USER=loefsys
POSTGRES_PASSWORD=CHANGEME

# --- Email ---
# Recommend pointing staging at a real but clearly-labelled sender, or a
# catch-all/sandbox SMTP provider, so test emails can't be mistaken for the
# real thing or land in real members' inboxes.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true

# --- Misc ---
DJANGO_TIME_ZONE=Europe/Amsterdam
